---
import Icon from './Icon.astro';
import { readingMinutes, isoDate, shortTitle, type Post } from '../lib/content';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const date = isoDate(d.date);
const w = d.series ? `W${String(d.series.week).padStart(2, '0')}/12` : '';
---
<article class="prow" data-tags={d.tags.join(',')} data-title={d.title}>
  <time class="prow__date label" datetime={date}>{date}</time>
  <h3 class="prow__title">
    {w && <span class="prow__series label">{w}</span>}
    <a href={`/log/${post.id}/`}>{shortTitle(post)}</a>
    <span class="prow__arrow" aria-hidden="true"><Icon name="arrow" /></span>
  </h3>
  <div class="tags">
    {d.tags.map((t) => <span class="tag">{t}</span>)}
    {d.draft && <span class="tag tag--dashed">Draft</span>}
  </div>
  <span class="prow__time label">{readingMinutes(post.body)} min</span>
</article>
