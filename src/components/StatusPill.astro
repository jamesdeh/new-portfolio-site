---
import { site } from '../config/site';
import { phaseInfo, pad2 } from '../lib/phase';

const { phase, week, month, monthLong, overridden } = phaseInfo();
const label =
  phase === 'before'
    ? `Status: in Wellington, moving to Sydney in ${monthLong}`
    : phase === 'during'
      ? `Status: in Sydney, week ${week} of 12`
      : 'Status: back in Wellington, internship finished';
// a previewed phase skips the client-side correction so it stays put
const dates = overridden ? {} : { 'data-start': site.internship.start, 'data-end': site.internship.end };
---
<a class:list={['status', { 'status--idle': phase === 'after' }]} href="/#now" aria-label={label} data-status {...dates}>
  <span class="status__dot" aria-hidden="true"></span>
  {phase === 'before' && <>WLG <span class="sep">→</span> SYD <span class="sep">·</span> {month}</>}
  {phase === 'during' && <>SYD <span class="sep">·</span> W{pad2(week)}/12</>}
  {phase === 'after' && <>WLG <span class="sep">·</span> 12/12 done</>}
</a>
