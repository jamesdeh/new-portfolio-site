---
import { readingMinutes, isoDate, type Post } from '../lib/content';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const date = isoDate(d.date);
---
<article class="pcard">
  <div class="pcard__meta micro">
    <time datetime={date}>{date}</time><span>·</span><span>{readingMinutes(post.body)} min</span>
    {d.draft && <><span>·</span><span class="acc">Draft</span></>}
  </div>
  <h3 class="pcard__title"><a href={`/log/${post.id}/`}>{d.title}</a></h3>
  <p class="pcard__ex">{d.summary}</p>
  <div class="pcard__foot"><div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div></div>
</article>
