---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Toc from '../../components/Toc.astro';
import Callout from '../../components/Callout.astro';
import ThreatStrip from '../../components/ThreatStrip.astro';
import Flow from '../../components/Flow.astro';
import Pipeline from '../../components/Pipeline.astro';
import DeadEnds from '../../components/DeadEnds.astro';
import Stats from '../../components/Stats.astro';
import { render } from 'astro:content';
import { getWork, hasPage, readingMinutes, isoDate, type Work } from '../../lib/content';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const all = await getWork();
  const work = all.filter(hasPage);
  return work.map((w) => ({ params: { slug: w.id }, props: { work: w, all: work } }));
}

interface Props {
  work: Work;
  all: Work[];
}
const { work, all } = Astro.props;
const d = work.data;
const { Content, headings } = await render(work);
const toc = headings.filter((h) => h.depth === 2);
const n = String(d.order).padStart(2, '0');
const i = all.indexOf(work);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const meta = d.meta ?? { year: d.year, role: d.role, stack: d.stack.join(', '), status: d.status === 'published' ? 'Published' : 'In progress' };
const pixel = d.pixelWord ?? '';
// the pixel word replaces the matching part of the title, in caps
const at = pixel ? d.title.toUpperCase().indexOf(pixel.toUpperCase()) : -1;
const [before, after] = at >= 0 ? [d.title.slice(0, at), d.title.slice(at + pixel.length)] : [d.title, ''];
const updated = isoDate(d.updated ?? new Date(site.nowUpdated));
---
<Base title={d.title} description={d.outcome} current="work" scripts={['copy-code', 'section-index']}>
  <main class="wrap" id="main">
    <header class="case-head">
      <nav class="crumb label" aria-label="Breadcrumb"><a href="/#work">Work</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span><span aria-hidden="true">·</span><span>Case study {n}</span></nav>
      <h1 class="h1 case-title">{at >= 0 ? <>{before}<span class="px">{pixel.toUpperCase()}</span>{after}</> : d.title}</h1>
      <p class="lead case-lead">{d.outcome}</p>
      <div class="meta-row">
        <div><span class="label">Year</span><span class="small">{meta.year}</span></div>
        <div><span class="label">Role</span><span class="small">{meta.role}</span></div>
        <div><span class="label">Stack</span><span class="small">{meta.stack}</span></div>
        <div><span class="label">Status</span><span class="small">{meta.status}</span></div>
      </div>
      <figure class="case-cover"><img src={d.cover.src} alt="" width={d.cover.width} height={d.cover.height} /></figure>
    </header>
    <div class="doc doc--case">
      <aside class="doc__rail" aria-label="Page contents">
        {toc.length > 0 && <Toc items={toc} />}
        <div class="stack micro muted gap-6"><span>Read time · {readingMinutes(work.body)} min</span><span>Updated · {updated}</span></div>
      </aside>
      <article class="doc__body">
        {toc.length > 0 && <Toc items={toc} mobile />}
        {d.status === 'pending' && <Callout type="warn" label="Draft · not published">This case study is still being written. It shows here because drafts are on for this build.</Callout>}
        <div class="prose">
          <Content components={{ Callout, ThreatStrip, Flow, Pipeline, DeadEnds, Stats }} />
        </div>
        {all.length > 1 && (
          <nav class="pn" aria-label="More work">
            <a href={`/work/${prev.id}/`}><span class="label"><Icon name="back" />Previous</span><span class="t">{prev.data.title}</span></a>
            <a href={`/work/${next.id}/`}><span class="label">Next<Icon name="arrow" /></span><span class="t">{next.data.title}</span></a>
          </nav>
        )}
      </article>
      <aside class="doc__aside" aria-label="Details">
        {d.aside?.map((a) => <div class="stack gap-6"><span class="label muted">{a.label}</span><span class="small">{a.value}</span></div>)}
        <div class="stack gap-6"><span class="label muted">Tags</span><div class="tags">{d.tags.slice(0, 2).map((t) => <span class="tag">{t}</span>)}</div></div>
      </aside>
    </div>
  </main>
</Base>
